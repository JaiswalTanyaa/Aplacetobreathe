{
  "name": "a-place-to-breathe-sanctuary",
  "version": "1.0.0",
  "description": "A Place to Breathe - Fullstack Mental Health Sanctuary (React + Vite + Node.js + MongoDB Atlas)",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "react",
    "vite",
    "node",
    "express",
    "mongodb-atlas",
    "mental-health",
    "wellness"
  ],
  "author": "",
  "license": "ISC"
}
